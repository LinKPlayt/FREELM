# Your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: port to run on (default 3000)
# PORT=3000

# Optional: require a password to use the app (recommended if you deploy it publicly)
# APP_PASSWORD=choose-something-strong

# Optional: override the model (default claude-opus-5-5)
# AI_MODEL=claude-opus-5-5
