# Cloud AI (optional). Your Anthropic API key from https://console.anthropic.com/
# Leave it commented out to run FREELM with local models only.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: port to run on (default 3000)
# PORT=3000

# Optional: require a password to use the app (recommended if you deploy it publicly)
# APP_PASSWORD=choose-something-strong

# Optional: override the model (default claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# Optional: where Ollama (the local AI engine) is running (default http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional: context window for local models, in tokens (default: Ollama's own default)
# LOCAL_CONTEXT=16384
